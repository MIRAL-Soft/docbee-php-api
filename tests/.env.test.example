# ============================================================
#  Docbee API — Integration Test Configuration
# ============================================================
#  Copy this file to tests/.env.test and fill in your real
#  credentials.
#
#  NEVER commit tests/.env.test to version control!
#  It is listed in .gitignore.
#
#  Run integration tests with:
#    composer test:integration
#  or:
#    php vendor/bin/phpunit --testsuite Integration --testdox
# ============================================================

# ── Required ─────────────────────────────────────────────────
# Your Docbee tenant subdomain (e.g. "mycompany" for mycompany.docbee.com)
DOCBEE_TENANT=your-tenant-name

# Your Docbee API token
DOCBEE_TOKEN=your-api-token-here

# ── Optional: IDs for top-level find($id) tests ──────────────
# When set, the corresponding find($id) test is executed.
# Leave commented out to skip those single-record assertions.

# DOCBEE_TEST_AGREEMENT_ID=1
# DOCBEE_TEST_AGREEMENT_TEMPLATE_ID=1
# DOCBEE_TEST_CONTINGENT_ID=1
# DOCBEE_TEST_COST_ESTIMATION_ID=1
# DOCBEE_TEST_COST_ESTIMATION_TEMPLATE_ID=1
# DOCBEE_TEST_CUSTOMER_ID=1
# DOCBEE_TEST_CUSTOMER_FILTER_ID=12345      # customer number (shown in Docbee UI), NOT the DB ID
#                                            # proves findByCustomer() server-side filter works
# DOCBEE_TEST_CUSTOMER_LOCATION_FILTER_ID=1 # proves findByCustomerLocation() filter works
# DOCBEE_TEST_DASHBOARD_ID=1
# DOCBEE_TEST_DOC_BEE_SCRIPT_ID=1
# DOCBEE_TEST_DOCUMENT_ID=1
# DOCBEE_TEST_DOCUMENT_TASK_ID=1
# DOCBEE_TEST_EXPORT_PROFILE_ID=1
# DOCBEE_TEST_PAYMENT_PROFILE_ID=1
# DOCBEE_TEST_PRESET_PROFILE_ID=1
# DOCBEE_TEST_PROTOCOL_ID=1
# DOCBEE_TEST_PROTOCOL_TEMPLATE_ID=1
# DOCBEE_TEST_PROTOCOL_TEMPLATE_ENTRY_ID=1
# DOCBEE_TEST_RULE_ENGINE_ACTION_ID=1
# DOCBEE_TEST_SELECTION_CATEGORY_ID=1
# DOCBEE_TEST_SLA_PROFILE_ID=1
# DOCBEE_TEST_TICKET_ID=1
# DOCBEE_TEST_TICKET_BOARD_ID=1

# ── Optional: parent IDs for sub-resource list() tests ───────
# Sub-resource tests are skipped entirely if the parent ID is missing.

# DOCBEE_TEST_AGREEMENT_COMPONENTS_PARENT_ID=1
# DOCBEE_TEST_AGREEMENT_COMPONENT_TEMPLATES_PARENT_ID=1
# DOCBEE_TEST_CONTINGENT_ELEMENTS_PARENT_ID=1
# DOCBEE_TEST_COST_ESTIMATION_TASKS_PARENT_ID=1
# DOCBEE_TEST_COST_ESTIMATION_TASK_TEMPLATES_PARENT_ID=1
# DOCBEE_TEST_DASHBOARD_WIDGETS_PARENT_ID=1
# DOCBEE_TEST_DOCUMENT_SUB_PARENT_ID=1
# DOCBEE_TEST_DOCUMENT_TASK_SUB_PARENT_ID=1
# DOCBEE_TEST_DOC_BEE_SCRIPT_PARAMS_PARENT_ID=1
# DOCBEE_TEST_PAYMENT_PROFILE_MAPPINGS_PARENT_ID=1
# DOCBEE_TEST_PRESET_VALUES_PARENT_ID=1
# DOCBEE_TEST_PROTOCOL_SUB_PARENT_ID=1
# DOCBEE_TEST_PROTOCOL_GROUP_PARENT_ID=1
# DOCBEE_TEST_PROTOCOL_GROUP_PROTOCOL_ID=1
# DOCBEE_TEST_PROTOCOL_GROUP_TEMPLATE_ID=1
# DOCBEE_TEST_PROTOCOL_TEMPLATE_DOC_PARENT_ID=1
# DOCBEE_TEST_PROTOCOL_TEMPLATE_ENTRY_ELEMENTS_PARENT_ID=1
# DOCBEE_TEST_RULE_ENGINE_SUB_PARENT_ID=1
# DOCBEE_TEST_SELECTION_VALUES_PARENT_ID=1
# DOCBEE_TEST_SLA_PROFILE_SUB_PARENT_ID=1
# DOCBEE_TEST_TICKET_SUB_PARENT_ID=1
